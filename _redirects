# Netlify / Cloudflare Pages redirects.
# Enable "Pretty URLs" (Netlify) so en/<slug>.html is served at /en/<slug> and /en/<slug>.html
# redirects there. Old #hash links are mapped by js/legacy-routes.js.
/            /fr/   302   Language=fr
/            /en/   301
/index.html  /en/   301
/en          /en/   301
/fr          /fr/   301
/en/index.html  /en/  301
/fr/index.html  /fr/  301
